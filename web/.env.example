# Where the ClipFlow API runs. Used by the Next server to proxy /api/* through
# this origin, so the browser never talks to the API port directly (no CORS).
API_ORIGIN=http://localhost:4000

# Canonical site URL, used for metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only set this when the API is deployed on its own domain and the browser
# should call it directly instead of going through the proxy above.
# NEXT_PUBLIC_API_URL=
