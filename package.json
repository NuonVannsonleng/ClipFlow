{
  "name": "clipflow",
  "version": "1.0.0",
  "private": true,
  "description": "ClipFlow \u2014 Save Your Favorite Public Videos, Simply.",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace server && npm run build --workspace web",
    "start": "concurrently -n server,web -c cyan,magenta \"npm:start:server\" \"npm:start:web\"",
    "start:server": "npm run start --workspace server",
    "start:web": "npm run start --workspace web",
    "typecheck": "npm run typecheck --workspace server && npm run typecheck --workspace web",
    "setup:tools": "node scripts/setup-tools.mjs",
    "doctor": "node scripts/doctor.mjs",
    "logos": "node scripts/generate-platform-logos.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "simple-icons": "^16.28.0"
  },
  "engines": {
    "node": ">=20"
  }
}
