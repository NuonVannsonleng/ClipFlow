# ---------- ClipFlow server ----------
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Public base URL of this API (used to build download links).
PUBLIC_API_URL=http://localhost:4000

# ---------- Media tooling ----------
# auto  -> use yt-dlp/ffmpeg if they are installed, otherwise return a clear
#          "tools unavailable" error (never silently fake a result)
# ytdlp -> require yt-dlp
# mock  -> offline sample data, for UI development only
MEDIA_PROVIDER=auto

# Leave empty to look the binaries up on PATH (and in ./bin).
YTDLP_PATH=
FFMPEG_PATH=
FFPROBE_PATH=

# ---------- Limits ----------
MAX_FILESIZE_MB=1024
JOB_TIMEOUT_MS=600000
ANALYZE_TIMEOUT_MS=45000
MAX_CONCURRENT_JOBS=2
MAX_BATCH_URLS=10
FILE_TTL_MS=1800000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_ANALYZE=20
RATE_LIMIT_PROCESS=10

# ---------- Storage ----------
TMP_DIR=.tmp

# ---------- Optional queue ----------
# Set a Redis URL to switch the job queue from in-memory to BullMQ.
REDIS_URL=

# ---------- Security ----------
# Allow requests that resolve to private/loopback addresses (dev only, unsafe).
ALLOW_PRIVATE_ADDRESSES=false
